# =============================================================================
# Quix Code - matriks konfigurasi lingkungan (T0-14)
# Salin ke .env lalu isi. JANGAN commit .env atau rahasia asli.
# Kolom: [L] local  [S] staging  [P] produksi
# =============================================================================

# --- Aplikasi ----------------------------------------------------------------
APP_NAME="Quix Code"
# L: local | S: staging | P: production
APP_ENV=local
# Buat dengan: php artisan key:generate. Rahasia: simpan di pengelola rahasia di S/P.
APP_KEY=
# L: true | S: false | P: false (WAJIB false di produksi)
APP_DEBUG=true
# L: http://localhost:8000 (atau http://quixcode.test) | S: https://staging.contoh.id | P: https://quixcode.my.id
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Log ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug           # L: debug | S: info | P: warning

# --- Database: MySQL 8 lokal (phpMyAdmin / XAMPP / Laragon) --------------------
# Buat database `quixcode` dan `quixcode_test` lewat phpMyAdmin
# (collation utf8mb4_unicode_ci). Tes memakai quixcode_test, BUKAN database dev.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quixcode
DB_USERNAME=root          # S/P: pengguna khusus dengan hak minimum, bukan root
DB_PASSWORD=              # L: kosong (XAMPP bawaan) | S/P: kata sandi kuat, rahasia
# Tes otomatis (phpunit.xml) memaksa DB_DATABASE=quixcode_test; host/pengguna/sandi dipakai dari sini.

# --- Sesi, cache, antrean -----------------------------------------------------
# Default memakai database (cukup dengan MySQL). Redis OPSIONAL: lihat docs/adr/0002.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=    # S/P: true (HTTPS)
CACHE_STORE=database      # opsional: redis
QUEUE_CONNECTION=database # opsional: redis
QUEUE_FAILED_DRIVER=database-uuids
# Isi hanya bila memakai Redis:
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null       # S/P: rahasia
REDIS_PORT=6379
# Ambang peringatan antrean (T5-09)
QUIX_QUEUE_MAX_PENDING=200
QUIX_QUEUE_WEBHOOK=critical
QUIX_ALERT_THROTTLE_MINUTES=10

# --- Storage ------------------------------------------------------------------
FILESYSTEM_DISK=local     # S/P: disk privat; berkas klien tidak pernah publik
UPLOAD_CLAMAV=false       # P: true bila clamscan terpasang
UPLOAD_CLAMAV_BINARY=clamscan

# --- Email --------------------------------------------------------------------
# L: log (email ditulis ke storage/logs) atau mailpit/mailtrap | S: smtp sandbox | P: resend/postmark/smtp
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null        # rahasia
MAIL_FROM_ADDRESS="hello@quixcode.my.id"   # P: harus domain sendiri (SPF/DKIM/DMARC)
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=           # rahasia; isi bila MAIL_MAILER=resend
POSTMARK_API_KEY=         # rahasia; isi bila MAIL_MAILER=postmark

# --- GitHub (webhook commit, T5) ----------------------------------------------
GITHUB_TOKEN=             # rahasia; fine-grained PAT, izin baca saja (Contents + Metadata)
GITHUB_API_URL=https://api.github.com
QUIX_WEBHOOK_BRANCH=main
QUIX_WEBHOOK_MAX_BODY_KB=5120
QUIX_WEBHOOK_PURGE_DAYS=90
QUIX_STALE_WEBHOOK_HOURS=24
QUIX_RECONCILE_LOOKBACK_DAYS=3
# Secret webhook disimpan per proyek di database (bukan di .env).

# --- WhatsApp (T5-10) ---------------------------------------------------------
# Driver: disabled | log | http. Penyedia gateway belum dipilih (Keputusan Terbuka, Bagian 10).
WHATSAPP_DRIVER=disabled # L: log | S: log/http sandbox | P: http
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=       # rahasia
WHATSAPP_TIMEOUT=5
QUIX_WHATSAPP_BREAKER_THRESHOLD=3
QUIX_WHATSAPP_BREAKER_MINUTES=10
QUIX_WHATSAPP_CONSENT_VERSION=1

# --- Anti-spam: Cloudflare Turnstile (T6-04) ----------------------------------
# L: none | S: turnstile dengan kunci uji | P: turnstile dengan kunci asli
CAPTCHA_DRIVER=none
CAPTCHA_SITE_KEY=         # publik
CAPTCHA_SECRET_KEY=       # rahasia
# Kunci uji resmi Cloudflare (selalu lolos): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA

# --- Kurs (estimasi harga publik, T6-09) ---------------------------------------
EXCHANGE_RATE_API_URL=    # contoh: https://v6.exchangerate-api.com/v6/KUNCI/latest/IDR
EXCHANGE_RATE_API_KEY=    # rahasia
EXCHANGE_RATE_TIMEOUT=8
QUIX_DEFAULT_IDR_PER_USD=16200
QUIX_EXCHANGE_RATE_STALE_HOURS=48

# --- Analitik (opsional) ------------------------------------------------------
ANALYTICS_PROVIDER=none   # none | plausible | umami
ANALYTICS_DOMAIN=
ANALYTICS_SCRIPT_URL=

# --- Pemantauan error (Sentry, T8-05) -------------------------------------------
SENTRY_LARAVEL_DSN=       # rahasia ringan; kosong di local (paket Sentry dipasang di T8-05)
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Kebijakan bisnis & kontak -------------------------------------------------
QUIX_SUPPORT_EMAIL=support@quixcode.my.id
QUIX_SUPPORT_WHATSAPP=
QUIX_DPO_EMAIL=privacy@quixcode.my.id
QUIX_PRIVACY_VERSION=2026.1
QUIX_TERMS_VERSION=2026.1
QUIX_DATA_RETENTION_YEARS=5
QUIX_FREE_REVISION_ROUNDS=2
QUIX_TICKET_SLA_HOURS=48
QUIX_INVOICE_REMINDER_DAYS=3
QUIX_DP_HOLD_AFTER_DAYS=14

# --- Vite ---------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
